{
  "name": "open-loom-desktop",
  "productName": "OpenLoom",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "OpenLoom desktop app: local-first screen recorder and meeting transcriber.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@open-loom/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.7.1",
    "electron-audio-loopback": "^1.0.6",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "matteo-brand": "workspace:*",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
