{
  "name": "open-loom",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source Loom + Granola: video recording and meeting transcription, all local.",
  "scripts": {
    "dev": "pnpm --filter open-loom-desktop dev",
    "build": "pnpm --filter open-loom-desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist": "pnpm --filter open-loom-desktop dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
