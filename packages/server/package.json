{
  "name": "loomforge-server",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Self-hosted share server for LoomForge: hosted watch pages, timestamped comments, emoji reactions, viewer analytics, password protection, expiry, email gate and custom branding in one small container.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "loomforge-server": "bin/loomforge-server.js"
  },
  "files": [
    "dist",
    "bin",
    "Dockerfile",
    "docker-compose.yml"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node bin/loomforge-server.js",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@loomforge/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.28",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
